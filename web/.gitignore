# --- 1. DEPENDENCIES ---
# pnpm-managed; `pnpm install` recreates node_modules. pnpm-lock.yaml IS committed.
/node_modules
/.pnp
.pnp.*
.yarn/*
# Exceptions: Yarn's own committed tooling, kept so a fresh clone builds without a global Yarn.
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- 2. BUILD OUTPUT ---
# Next.js build (.next), static export (out), standalone bundle (build).
/.next/
/out/
/build

# --- 3. TEST AND COVERAGE OUTPUT ---
# Vitest coverage and Playwright's run artifacts.
/coverage
/playwright-report
/test-results
/.playwright-tmp

# --- 4. TYPESCRIPT ARTIFACTS ---
# next-env.d.ts is regenerated by `next dev` / `next build`; tsbuildinfo is the incremental cache.
*.tsbuildinfo
next-env.d.ts

# --- 5. LOGS ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- 6. LOCAL ENV AND SECRETS ---
# All env files are local; opt one in explicitly with `git add -f` if it must be shared.
.env*
*.pem

# --- 7. DEPLOY (Vercel) ---
.vercel

# --- 8. EDITOR AND OS ---
.DS_Store
