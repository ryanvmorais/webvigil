{
  "components": {
    "schemas": {
      "CheckOut": {
        "description": "One registered check, for the check-catalogue endpoint.",
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "cwe": {
            "items": {
              "type": "integer"
            },
            "title": "Cwe",
            "type": "array"
          },
          "default_severity": {
            "title": "Default Severity",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "references": {
            "items": {
              "type": "string"
            },
            "title": "References",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "mode",
          "default_severity",
          "cwe",
          "references"
        ],
        "title": "CheckOut",
        "type": "object"
      },
      "EvidenceOut": {
        "description": "One labelled evidence snippet.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "label",
          "content"
        ],
        "title": "EvidenceOut",
        "type": "object"
      },
      "FailOn": {
        "enum": [
          "none",
          "info",
          "low",
          "medium",
          "high",
          "critical"
        ],
        "type": "string"
      },
      "FindingOut": {
        "description": "One finding in a scan-detail response; severity and confidence as names, not ints.",
        "properties": {
          "check_id": {
            "title": "Check Id",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "string"
          },
          "cwe": {
            "items": {
              "type": "integer"
            },
            "title": "Cwe",
            "type": "array"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceOut"
            },
            "title": "Evidence",
            "type": "array"
          },
          "fingerprint": {
            "title": "Fingerprint",
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/LocationOut"
          },
          "references": {
            "items": {
              "type": "string"
            },
            "title": "References",
            "type": "array"
          },
          "remediation": {
            "title": "Remediation",
            "type": "string"
          },
          "severity": {
            "title": "Severity",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "check_id",
          "severity",
          "confidence",
          "title",
          "description",
          "location",
          "remediation",
          "evidence",
          "cwe",
          "references",
          "fingerprint"
        ],
        "title": "FindingOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthOut": {
        "description": "The health endpoint's payload: liveness and the tool version.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "LocationOut": {
        "description": "A finding's location in a response.",
        "properties": {
          "cookie": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cookie"
          },
          "header": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Header"
          },
          "method": {
            "default": "GET",
            "title": "Method",
            "type": "string"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Param"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "LocationOut",
        "type": "object"
      },
      "LoginIn": {
        "description": "Login body.",
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "Page_ScanSummary_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ScanSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "Page[ScanSummary]",
        "type": "object"
      },
      "PasswordChangeIn": {
        "description": "Password-change body: the current password plus the new one.",
        "properties": {
          "current_password": {
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 256,
            "minLength": 8,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "PasswordChangeIn",
        "type": "object"
      },
      "ScanCreate": {
        "description": "New-scan request body.\n\nAttributes:\n    target (str): The URL to scan; validated with\n        :meth:`~webvigil.core.target.Target.parse`.\n    mode (ScanMode): Passive (default) or Active.\n    scope (Scope): Crawl breadth. Defaults to\n        :attr:`~webvigil.core.target.Scope.HOST`.\n    max_pages (int | None): Crawler page cap; must be > 0 when given.\n    delay_ms (int | None): Delay between requests; must be >= 0 when given.\n    follow_robots (bool | None): Honour ``robots.txt``.\n    authorized_by (str | None): Required for an Active scan.\n    fail_on (FailOn | None): Recorded on the scan for later report exit\n        codes.\n    disabled_checks (list[str]): Check ids to skip. Defaults to empty.",
        "properties": {
          "authorized_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorized By"
          },
          "delay_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delay Ms"
          },
          "disabled_checks": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Disabled Checks",
            "type": "array"
          },
          "fail_on": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FailOn"
              },
              {
                "type": "null"
              }
            ]
          },
          "follow_robots": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Follow Robots"
          },
          "max_pages": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Pages"
          },
          "mode": {
            "$ref": "#/components/schemas/ScanMode",
            "default": "passive"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope",
            "default": "host"
          },
          "target": {
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "title": "ScanCreate",
        "type": "object"
      },
      "ScanDefaults": {
        "description": "The default scan options, so the UI's new-scan form can pre-fill them.",
        "properties": {
          "delay_ms": {
            "title": "Delay Ms",
            "type": "integer"
          },
          "fail_on": {
            "title": "Fail On",
            "type": "string"
          },
          "follow_robots": {
            "title": "Follow Robots",
            "type": "boolean"
          },
          "max_pages": {
            "title": "Max Pages",
            "type": "integer"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "scope": {
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "scope",
          "max_pages",
          "delay_ms",
          "follow_robots",
          "fail_on"
        ],
        "title": "ScanDefaults",
        "type": "object"
      },
      "ScanMode": {
        "description": "Safe Mode (default) versus opt-in Active Mode.\n\nAttributes:\n    PASSIVE (str): Observation only \u2014 safe to point at production.\n    ACTIVE (str): Sends crafted requests; requires an authorization.",
        "enum": [
          "passive",
          "active"
        ],
        "title": "ScanMode",
        "type": "string"
      },
      "ScanOut": {
        "description": "The full scan-detail response: everything in :class:`ScanSummary` plus the extras.\n\nAttributes:\n    authorized_by (str | None): Active-Mode attestation.\n    tool_version (str | None): WebVigil version that ran the scan.\n    error (str | None): Failure message, when applicable.\n    pages_scanned (int): Pages the crawler fetched.\n    options (dict[str, Any]): The request's extra options.\n    technologies (list[TechnologyOut]): The detected-technology inventory.",
        "properties": {
          "authorized_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorized By"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Counts",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "options": {
            "additionalProperties": true,
            "title": "Options",
            "type": "object"
          },
          "pages_scanned": {
            "title": "Pages Scanned",
            "type": "integer"
          },
          "scope": {
            "title": "Scope",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "technologies": {
            "items": {
              "$ref": "#/components/schemas/TechnologyOut"
            },
            "title": "Technologies",
            "type": "array"
          },
          "tool_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Version"
          }
        },
        "required": [
          "id",
          "target",
          "mode",
          "scope",
          "status",
          "counts",
          "created_at",
          "started_at",
          "finished_at",
          "authorized_by",
          "tool_version",
          "error",
          "pages_scanned",
          "options",
          "technologies"
        ],
        "title": "ScanOut",
        "type": "object"
      },
      "ScanStatus": {
        "description": "Lifecycle state of a stored scan.\n\nAttributes:\n    QUEUED (str): Waiting for the runner's execution slot.\n    RUNNING (str): Currently executing.\n    COMPLETED (str): Finished; findings are stored.\n    FAILED (str): Ended with a controlled engine error or a crash.\n    CANCELLED (str): Cancelled by the user.\n    INTERRUPTED (str): Left ``RUNNING`` by a process that died; recovered on\n        the next startup.",
        "enum": [
          "queued",
          "running",
          "completed",
          "failed",
          "cancelled",
          "interrupted"
        ],
        "title": "ScanStatus",
        "type": "string"
      },
      "ScanSummary": {
        "description": "A scan as it appears in the list endpoint \u2014 identity, status, severity counts.",
        "properties": {
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Counts",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "scope": {
            "title": "Scope",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "id",
          "target",
          "mode",
          "scope",
          "status",
          "counts",
          "created_at",
          "started_at",
          "finished_at"
        ],
        "title": "ScanSummary",
        "type": "object"
      },
      "Scope": {
        "description": "How wide the scan is allowed to reach.\n\nAttributes:\n    HOST (str): Only the exact target host.\n    SUBDOMAINS (str): The target's registrable domain and any subdomain.",
        "enum": [
          "host",
          "subdomains"
        ],
        "title": "Scope",
        "type": "string"
      },
      "SetupIn": {
        "description": "First-run setup body: the credentials for the single account.",
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "SetupIn",
        "type": "object"
      },
      "TechnologyOut": {
        "description": "One detected client-side library (spec 004, RF-17). Detail payload only.\n\nAttributes:\n    name (str): Library name.\n    version (str | None): Detected version, or ``None``.\n    detection (str): How it was found (the ``DetectionMethod`` value).\n    source_url (str): URL the detection came from.\n    vulnerable (bool): Whether an advisory matched.\n    advisories (list[str]): Matching advisory identifiers.",
        "properties": {
          "advisories": {
            "items": {
              "type": "string"
            },
            "title": "Advisories",
            "type": "array"
          },
          "detection": {
            "title": "Detection",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "vulnerable": {
            "title": "Vulnerable",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "version",
          "detection",
          "source_url",
          "vulnerable",
          "advisories"
        ],
        "title": "TechnologyOut",
        "type": "object"
      },
      "UserOut": {
        "description": "The current user, as returned by the auth endpoints.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "created_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "WebVigil API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Verify the credentials and set the session cookie. 401 on any mismatch.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Clear the session cookie. Always succeeds, authenticated or not.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "description": "The current user, for the UI to render the session state.",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/password": {
      "post": {
        "description": "Change the password after re-checking the current one. 403 if it is wrong.",
        "operationId": "change_password_api_auth_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordChangeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/checks": {
      "get": {
        "description": "The full check catalogue \u2014 the same list as ``webvigil list-checks``, with metadata.",
        "operationId": "list_checks_api_checks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CheckOut"
                  },
                  "title": "Response List Checks Api Checks Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Checks",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/config/defaults": {
      "get": {
        "description": "The default scan options, so the UI's new-scan form can pre-fill sensible values.",
        "operationId": "config_defaults_api_config_defaults_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanDefaults"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Config Defaults",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Liveness probe and tool version. The only unauthenticated endpoint besides setup.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/scans": {
      "get": {
        "description": "Newest scans first, optionally filtered by ``status``, cursor-paginated by ``limit``.",
        "operationId": "list_scans_api_scans_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ScanStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
