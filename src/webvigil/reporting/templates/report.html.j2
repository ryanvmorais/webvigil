{#
  Standalone HTML scan report, rendered by webvigil.reporting.html.HtmlReporter.

  Self-contained by contract (RF-23): the <style> below is the only styling and
  the page pulls in no external CSS, script, font, or image — it must render
  from a file:// path with no network. Every comment here is a Jinja comment
  rather than an HTML one, so the delivered report carries no markup noise; the
  Environment runs with trim_blocks + lstrip_blocks, so a comment alone on its
  line leaves nothing in the output.

  Context in: meta, severities, warnings, technologies, findings, errors.
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WebVigil scan report — {{ meta.target }}</title>
{# Palette + layout + one badge colour per severity, with a prefers-color-scheme dark set. #}
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  body { margin: 0; font: 15px/1.5 system-ui, sans-serif; background: #fbfbfd; color: #1c1c22; }
  main { max-width: 60rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
  h1 { font-size: 1.5rem; margin: 0 0 .25rem; }
  .meta { color: #55555f; font-size: .9rem; margin-bottom: 1.5rem; }
  table.summary { border-collapse: collapse; margin: 1rem 0 2rem; }
  table.summary th, table.summary td { border: 1px solid #d7d7de; padding: .35rem .8rem; text-align: left; }
  .finding { border: 1px solid #d7d7de; border-radius: 8px; padding: 1rem 1.25rem; margin: 0 0 1rem; background: #fff; }
  .finding h2 { font-size: 1.05rem; margin: 0 0 .5rem; }
  .badge { display: inline-block; font-size: .72rem; font-weight: 700; letter-spacing: .04em;
           padding: .12rem .5rem; border-radius: 999px; margin-right: .5rem; text-transform: uppercase; }
  .sev-CRITICAL { background: #7f1d1d; color: #fff; }
  .sev-HIGH { background: #b91c1c; color: #fff; }
  .sev-MEDIUM { background: #b45309; color: #fff; }
  .sev-LOW { background: #1d4ed8; color: #fff; }
  .sev-INFO { background: #4b5563; color: #fff; }
  .kv { color: #55555f; font-size: .85rem; margin: .25rem 0; }
  pre { background: #f2f2f5; padding: .75rem; border-radius: 6px; overflow-x: auto; font-size: .82rem; }
  .remediation { border-left: 3px solid #1d4ed8; padding-left: .8rem; margin: .75rem 0; }
  a { color: #1d4ed8; }
  @media (prefers-color-scheme: dark) {
    body { background: #16161a; color: #e6e6ea; }
    .finding { background: #1f1f25; border-color: #33333c; }
    table.summary th, table.summary td { border-color: #33333c; }
    pre { background: #26262d; }
    .meta, .kv { color: #a0a0aa; }
  }
</style>
</head>
<body>
<main>
  {# Header — target, scan mode/scope, page count, timestamp, and the Active-Mode authoriser when set. #}
  <h1>WebVigil scan report</h1>
  <p class="meta">
    {{ meta.target }} &middot; mode <code>{{ meta.mode.value }}</code> &middot;
    scope <code>{{ meta.scope.value }}</code> &middot; {{ meta.pages_scanned }} page(s) &middot;
    {{ meta.started_at.strftime("%Y-%m-%d %H:%M:%SZ") }}
    {% if meta.authorized_by %}<br>Authorized by: {{ meta.authorized_by }}{% endif %}
  </p>

  {# Severity summary — every level listed, including the zero rows, so the table shape is stable. #}
  <table class="summary">
    <tr><th>Severity</th><th>Count</th></tr>
    {% for sev in severities %}
    <tr><td>{{ sev.name }}</td><td>{{ meta.counts.get(sev.name, 0) }}</td></tr>
    {% endfor %}
  </table>

  {# Non-fatal warnings (e.g. an OSV lookup that failed) — the scan still completed. #}
  {% if warnings %}
  <p class="meta">Warnings: {% for w in warnings %}{{ w }}{% if not loop.last %}; {% endif %}{% endfor %}</p>
  {% endif %}

  {# Dependency inventory — shown only when fingerprinting ran; "—" in Status means no known advisory. #}
  {% if technologies %}
  <h2>Detected technologies</h2>
  <table class="summary">
    <tr><th>Library</th><th>Version</th><th>Detection</th><th>Status</th></tr>
    {% for t in technologies %}
    <tr>
      <td>{{ t.name }}</td>
      <td>{{ t.version or "unknown" }}</td>
      <td>{{ t.detection.value }}</td>
      <td>{% if t.vulnerable %}Vulnerable{% if t.advisories %} ({{ t.advisories | join(", ") }}){% endif %}{% else %}—{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if not findings %}
  <p>No findings.</p>
  {% endif %}

  {#
    One <section> per finding, already sorted by HtmlReporter (severity desc).
    Each carries the severity badge, the check id + confidence + CWEs, the
    location (URL, plus the injection point key when present), description,
    remediation, collapsible evidence blocks, and reference links.
  #}
  {% for f in findings %}
  <section class="finding">
    <h2><span class="badge sev-{{ f.severity.name }}">{{ f.severity.name }}</span>{{ f.title }}</h2>
    <p class="kv">Check <code>{{ f.check_id }}</code> &middot; confidence {{ f.confidence.name }}
      {% if f.cwe %}&middot; {% for c in f.cwe %}CWE-{{ c }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
    </p>
    <p class="kv">Location: {{ f.location.url }}{% if f.location.key %} (<code>{{ f.location.key }}</code>){% endif %}</p>
    <p>{{ f.description }}</p>
    <p class="remediation"><strong>Remediation:</strong> {{ f.remediation }}</p>
    {% for item in f.evidence %}
    <details><summary>{{ item.label }}</summary><pre>{{ item.content }}</pre></details>
    {% endfor %}
    {% if f.references %}
    <p class="kv">{% for r in f.references %}<a href="{{ r }}">{{ r }}</a>{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
    {% endif %}
  </section>
  {% endfor %}

  {# Checks that raised — listed so a partial scan is never mistaken for a clean one. #}
  {% if errors %}
  <section class="finding">
    <h2>Check errors</h2>
    <ul>{% for e in errors %}<li><code>{{ e.check_id }}</code>: {{ e.message }}</li>{% endfor %}</ul>
  </section>
  {% endif %}
</main>
</body>
</html>
